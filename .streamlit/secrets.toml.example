# Paste into Community Cloud > Advanced settings > Secrets.
# Replace placeholders with your existing credentials; keep these at root level.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
OPENAI_API_KEY = "replace-with-your-provider-key"
PINECONE_API_KEY = "replace-with-your-pinecone-key"
PINECONE_INDEX_HOST = "https://your-index-host"
